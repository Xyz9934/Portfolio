PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=friday-ai

GEMINI_API_KEY=your_primary_gemini_key
GEMINI_API_KEY_BACKUP=your_backup_gemini_key
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Speak in a warm, natural female voice with clear pronunciation.

EMBED_MODEL=all-MiniLM-L6-v2

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_QUICK_MODEL=llama3.2
OLLAMA_DEEP_MODEL=llama3
OLLAMA_KEEP_ALIVE=10m
PREFER_OFFLINE_BRAIN=true

FIRESTORE_PROJECT_ID=your_firestore_project_id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app/
FIREBASE_CREDENTIALS_PATH=D:\FRIDAY\firebase_key.json
FIREBASE_ENABLED=0
FIRESTORE_ENABLED=0

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=your_cloudflare_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
